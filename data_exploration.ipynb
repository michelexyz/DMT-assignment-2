   },
   "outputs": [],
   "source": [
    "# PARAMETERS\n",
    "\n",
    "train_path = \"data/basic_dataset.csv\"\n",
    "train_path = \"data/training_set_VU_DM.csv\"\n",
    "# for testing: train_path = \"data/small_dataset.csv\"\n",
    "stats_path = f\"stats/{train_path.split('/')[1][:-4]}_stats.csv\"\n",
    "save_output = True\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "b4aabe1857caf619",
   "metadata": {
    "collapsed": false,
