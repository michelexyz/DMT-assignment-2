   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "load chunk: 0.02s\n",
      "concat df: 22.49s\n"
     ]
    }
   ],
   "source": [
    "# LOAD DATA\n",
    "\n",
    "start_time = time.time()\n",
    "chunk = pd.read_csv(train_path, chunksize=1000000)\n",
    "print(f\"load chunk: {time.time() - start_time:.2f}s\")\n",
    "\n",
    "start_time = time.time()\n",
    "df = pd.concat(chunk)\n",
    "print(f\"concat df: {time.time() - start_time:.2f}s\")"
   ]
  },
