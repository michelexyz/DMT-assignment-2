  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "outputs": [],
   "source": [
    "# Things to plot to visualize the data:\n",
    "# - comparison of distribution of each column, for booked and not booked rows\n",
    "# - comparison of distribution of each column, for clicked and not clicked rows\n",
    "# - distribution of sum rowwise, for clicked and not clicked rows\n",
    "# - max rowwise, for clicked and not clicked rows\n",
    "# - min rowwise, for clicked and not clicked rows\n",
    "# - kurtosis rowwise, for clicked and not clicked rows\n",
    "# - skewness rowwise, for clicked and not clicked rows\n",
    "# - correlation matrix for all columns"
   ]
  },
  {
   "cell_type": "code",
